{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "pnpm run test:safety && pnpm run test:sms",
    "test:bedrock": "esbuild src/scripts/bedrock-connectivity.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bedrock-connectivity.mjs && node --enable-source-maps dist/bedrock-connectivity.mjs",
    "test:safety": "export MODEL_PROVIDER=local && esbuild src/scripts/rebooking-safety.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/rebooking-safety.mjs && node --enable-source-maps dist/rebooking-safety.mjs",
    "test:sms": "esbuild src/scripts/aws-sms-provider-unit.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/aws-sms-provider-unit.mjs && node --enable-source-maps dist/aws-sms-provider-unit.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1136.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1136.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
