{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:agentcore": "node build-agentcore.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "pnpm run test:public-demo && pnpm run test:channels && pnpm run test:safety && pnpm run test:itinerary-channel && pnpm run test:passengers && pnpm run test:interpret-message && pnpm run test:sms && pnpm run test:ses && pnpm run test:readiness && pnpm run test:reset && pnpm run test:aws-demo",
    "test:aws-demo": "esbuild src/scripts/aws-demo-unit.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/aws-demo-unit.mjs && node --enable-source-maps dist/aws-demo-unit.mjs",
    "test:channels": "export MODEL_PROVIDER=local && esbuild src/scripts/channel-routing-unit.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/api-zod=../../lib/api-zod/src/index.ts --alias:zod=../../lib/api-zod/node_modules/zod --outfile=dist/channel-routing-unit.mjs && node --enable-source-maps dist/channel-routing-unit.mjs",
    "test:bedrock": "esbuild src/scripts/bedrock-connectivity.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bedrock-connectivity.mjs && node --enable-source-maps dist/bedrock-connectivity.mjs",
    "test:safety": "export MODEL_PROVIDER=local && esbuild src/scripts/rebooking-safety.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/rebooking-safety.mjs && node --enable-source-maps dist/rebooking-safety.mjs",
    "test:itinerary-channel": "esbuild src/scripts/itinerary-channel-unit.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/api-zod=../../lib/api-zod/src/index.ts --alias:zod=../../lib/api-zod/node_modules/zod --outfile=dist/itinerary-channel-unit.mjs && node --enable-source-maps dist/itinerary-channel-unit.mjs",
    "test:passengers": "export MODEL_PROVIDER=local && esbuild src/scripts/passenger-scenarios-unit.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/passenger-scenarios-unit.mjs && node --enable-source-maps dist/passenger-scenarios-unit.mjs",
    "test:interpret-message": "export MODEL_PROVIDER=local && esbuild src/scripts/message-interpretation-unit.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/message-interpretation-unit.mjs && node --enable-source-maps dist/message-interpretation-unit.mjs",
    "test:sms": "esbuild src/scripts/aws-sms-provider-unit.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/aws-sms-provider-unit.mjs && node --enable-source-maps dist/aws-sms-provider-unit.mjs",
    "test:ses": "esbuild src/scripts/aws-ses-provider-unit.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/aws-ses-provider-unit.mjs && node --enable-source-maps dist/aws-ses-provider-unit.mjs",
    "test:readiness": "esbuild src/scripts/readiness-unit.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/readiness-unit.mjs && node --enable-source-maps dist/readiness-unit.mjs",
    "test:reset": "esbuild src/scripts/reset-session-unit.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=./src/scripts/demo-db-mock.ts --alias:@workspace/api-zod=../../lib/api-zod/src/index.ts --alias:zod=../../lib/api-zod/node_modules/zod --outfile=dist/reset-session-unit.mjs && node --enable-source-maps dist/reset-session-unit.mjs",
    "test:public-demo": "esbuild src/scripts/public-demo-unit.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=./src/scripts/demo-db-mock.ts --alias:@workspace/api-zod=../../lib/api-zod/src/index.ts --alias:zod=../../lib/api-zod/node_modules/zod --outfile=dist/public-demo-unit.mjs && node dist/public-demo-unit.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1156.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1136.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1136.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
