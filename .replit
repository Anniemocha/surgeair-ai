modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
AWS_REGION = "eu-north-1"
BEDROCK_MODEL_ID = "eu.amazon.nova-2-lite-v1:0"
MODEL_PROVIDER = "bedrock"
SMS_PROVIDER = "aws"
SMS_TEST_MIN_INTERVAL_MS = "30000"
EMAIL_PROVIDER = "aws"
AWS_SES_ENABLED = "true"
AGENTCORE_RUNTIME_ARN = "arn:aws:bedrock-agentcore:eu-north-1:661406599883:runtime/surgeair_ai_agent-YzOD6XHzSm"
AWS_SMS_SIMULATOR_DESTINATION = "+14254147755"
AWS_SMS_ORIGINATION_NUMBER = " +12065551702"

[nix]
channel = "stable-25_05"
